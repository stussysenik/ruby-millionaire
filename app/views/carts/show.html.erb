<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="section-heading mb-8">Your Cart</h1>

  <turbo-frame id="cart-contents">
    <% if @cart.empty? %>
      <div class="card-aero p-12 text-center">
        <svg class="w-20 h-20 mx-auto text-aero-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
        <h3 class="font-display text-lg text-steel-300">Your cart is empty</h3>
        <p class="text-sm text-steel-400 mt-1">Browse our catalog to find aerospace-grade components.</p>
        <%= link_to "Browse Catalog", products_path, class: "btn-primary mt-4" %>
      </div>
    <% else %>
      <div class="space-y-4">
        <% @cart_items.each do |item| %>
          <div class="card-aero p-4 flex items-center gap-4" id="<%= dom_id(item) %>">
            <!-- Image -->
            <div class="w-20 h-20 bg-aero-700/30 rounded-md overflow-hidden shrink-0">
              <% if item.product.images.attached? %>
                <%= image_tag product_image_url(item.product, variant: :thumb), class: "w-full h-full object-cover", alt: item.product.name %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center">
                  <svg class="w-8 h-8 text-aero-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                  </svg>
                </div>
              <% end %>
            </div>

            <!-- Info -->
            <div class="flex-1 min-w-0">
              <%= link_to item.product.name, product_path(item.product), class: "font-display text-sm font-bold tracking-wider text-steel-100 hover:text-accent transition-colors block truncate" %>
              <div class="text-xs font-mono text-steel-400">PN: <%= item.product.part_number %></div>
              <div class="text-sm text-accent font-bold mt-1"><%= format_price(item.product.price_cents) %> each</div>
            </div>

            <!-- Quantity -->
            <div class="flex items-center border border-aero-600 rounded-md" data-controller="quantity">
              <%= form_with url: cart_cart_item_path(item), method: :patch, class: "contents" do |f| %>
                <button type="button" class="px-2 py-1.5 text-steel-400 hover:text-accent transition-colors cursor-pointer"
                        data-action="click->quantity#decrement click->quantity#submitForm">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/></svg>
                </button>
                <input type="number" name="quantity" value="<%= item.quantity %>" min="1"
                       class="w-12 text-center bg-transparent text-steel-100 font-mono text-sm border-x border-aero-600 py-1 focus:outline-none"
                       data-quantity-target="input">
                <button type="button" class="px-2 py-1.5 text-steel-400 hover:text-accent transition-colors cursor-pointer"
                        data-action="click->quantity#increment click->quantity#submitForm">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                </button>
              <% end %>
            </div>

            <!-- Line Total -->
            <div class="text-right shrink-0 w-24">
              <div class="font-display font-bold text-steel-100"><%= format_price(item.line_total_cents) %></div>
            </div>

            <!-- Remove -->
            <%= button_to cart_cart_item_path(item), method: :delete, class: "p-2 text-steel-400 hover:text-danger transition-colors cursor-pointer shrink-0" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Summary -->
      <div class="card-aero p-6 mt-8">
        <div class="flex items-center justify-between text-lg mb-4">
          <span class="font-display tracking-wider text-steel-300">Subtotal</span>
          <span class="font-display font-bold text-accent text-xl"><%= format_price(@cart.subtotal_cents) %></span>
        </div>
        <p class="text-xs text-steel-400 mb-6">Shipping and taxes calculated at checkout.</p>

        <div class="flex gap-4">
          <%= link_to "Continue Shopping", products_path, class: "btn-secondary flex-1 text-center" %>
          <% if authenticated? %>
            <%= button_to "Proceed to Checkout", checkouts_path, class: "btn-primary flex-1" %>
          <% else %>
            <%= link_to "Sign In to Checkout", new_session_path, class: "btn-primary flex-1 text-center" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </turbo-frame>
</div>
