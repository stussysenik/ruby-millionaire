<div class="min-h-[80vh] flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <div class="flex items-center justify-center gap-2 mb-4">
        <svg class="w-10 h-10 text-accent" viewBox="0 0 32 32" fill="currentColor">
          <polygon points="16,2 28,10 28,22 16,30 4,22 4,10"/>
        </svg>
      </div>
      <h1 class="font-display text-2xl font-bold tracking-wider text-steel-100">Create Account</h1>
      <p class="text-sm text-steel-400 mt-1">Join AeroParts Pro today</p>
    </div>

    <div class="card-aero p-8">
      <%= form_with model: @user, url: registration_path, class: "space-y-5" do |f| %>
        <% if @user.errors.any? %>
          <div class="flash-alert text-sm">
            <% @user.errors.full_messages.each do |msg| %>
              <div><%= msg %></div>
            <% end %>
          </div>
        <% end %>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">First Name</label>
            <%= f.text_field :first_name, class: "input-aero", placeholder: "John" %>
          </div>
          <div>
            <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Last Name</label>
            <%= f.text_field :last_name, class: "input-aero", placeholder: "Doe" %>
          </div>
        </div>

        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Email Address</label>
          <%= f.email_field :email_address, class: "input-aero", placeholder: "you@company.com", autofocus: true, required: true %>
        </div>

        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Password</label>
          <%= f.password_field :password, class: "input-aero", placeholder: "Minimum 8 characters", required: true %>
        </div>

        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Confirm Password</label>
          <%= f.password_field :password_confirmation, class: "input-aero", placeholder: "Repeat password", required: true %>
        </div>

        <%= f.submit "Create Account", class: "btn-primary w-full" %>
      <% end %>
    </div>

    <p class="text-center text-sm text-steel-400 mt-6">
      Already have an account?
      <%= link_to "Sign in", new_session_path, class: "text-accent hover:text-accent-hover font-bold" %>
    </p>
  </div>
</div>
