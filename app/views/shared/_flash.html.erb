<div class="fixed top-20 right-4 z-50 space-y-2" data-controller="flash">
  <% flash.each do |type, message| %>
    <div class="<%= type == 'notice' ? 'flash-notice' : 'flash-alert' %> flex items-center gap-3 pr-2 shadow-lg max-w-md"
         data-flash-target="message"
         data-action="animationend->flash#remove">
      <span class="flex-1 text-sm"><%= message %></span>
      <button data-action="click->flash#dismiss" class="p-1 opacity-60 hover:opacity-100 transition-opacity cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  <% end %>
</div>
