<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="section-heading mb-8">Order History</h1>

  <% if @orders.any? %>
    <div class="space-y-4">
      <% @orders.each do |order| %>
        <%= link_to account_order_path(order), class: "card-aero p-6 block group" do %>
          <div class="flex items-center justify-between">
            <div>
              <div class="font-mono text-sm text-accent font-bold"><%= order.order_number %></div>
              <div class="text-xs text-steel-400 mt-1"><%= order.created_at.strftime("%B %d, %Y at %I:%M %p") %></div>
            </div>
            <div class="text-right">
              <div class="font-display font-bold text-steel-100"><%= format_price(order.total_cents) %></div>
              <%= status_badge(order.status) %>
            </div>
          </div>
          <div class="mt-3 text-xs text-steel-400">
            <%= order.order_items.count %> item<%= order.order_items.count == 1 ? '' : 's' %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="card-aero p-12 text-center">
      <h3 class="font-display text-lg text-steel-300">No orders yet</h3>
      <p class="text-sm text-steel-400 mt-1">Your order history will appear here.</p>
      <%= link_to "Browse Catalog", products_path, class: "btn-primary mt-4" %>
    </div>
  <% end %>
</div>
