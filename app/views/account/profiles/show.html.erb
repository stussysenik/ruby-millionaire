<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="section-heading mb-8">My Account</h1>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Sidebar Nav -->
    <div class="space-y-2">
      <%= link_to "Profile", account_profile_path, class: "block card-aero p-4 border-accent/30 bg-accent/5" %>
      <%= link_to "Orders", account_orders_path, class: "block card-aero p-4 hover:border-accent/30" %>
      <%= link_to "Addresses", account_addresses_path, class: "block card-aero p-4 hover:border-accent/30" %>
    </div>

    <!-- Profile Card -->
    <div class="md:col-span-2 card-aero p-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-display text-lg tracking-wider text-steel-100">Profile Details</h2>
        <%= link_to "Edit", edit_account_profile_path, class: "btn-secondary btn-sm" %>
      </div>

      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="text-xs font-display uppercase tracking-widest text-steel-400">First Name</label>
            <div class="text-steel-100 mt-1"><%= @user.first_name || "—" %></div>
          </div>
          <div>
            <label class="text-xs font-display uppercase tracking-widest text-steel-400">Last Name</label>
            <div class="text-steel-100 mt-1"><%= @user.last_name || "—" %></div>
          </div>
        </div>

        <div>
          <label class="text-xs font-display uppercase tracking-widest text-steel-400">Email</label>
          <div class="text-steel-100 mt-1 font-mono"><%= @user.email_address %></div>
        </div>

        <div>
          <label class="text-xs font-display uppercase tracking-widest text-steel-400">Phone</label>
          <div class="text-steel-100 mt-1"><%= @user.phone || "—" %></div>
        </div>

        <div>
          <label class="text-xs font-display uppercase tracking-widest text-steel-400">Member Since</label>
          <div class="text-steel-100 mt-1"><%= @user.created_at.strftime("%B %d, %Y") %></div>
        </div>
      </div>
    </div>
  </div>
</div>
