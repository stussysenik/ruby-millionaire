<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="section-heading">Address Book</h1>
    <%= link_to "Add Address", new_account_address_path, class: "btn-primary btn-sm" %>
  </div>

  <% if @addresses.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @addresses.each do |address| %>
        <div class="card-aero p-6">
          <div class="flex items-start justify-between mb-3">
            <span class="badge-status"><%= address.address_type %></span>
            <div class="flex gap-2">
              <%= link_to "Edit", edit_account_address_path(address), class: "text-xs text-accent hover:text-accent-hover" %>
              <%= button_to "Delete", account_address_path(address), method: :delete, class: "text-xs text-danger hover:text-danger/80 cursor-pointer", data: { turbo_confirm: "Remove this address?" } %>
            </div>
          </div>
          <div class="text-sm text-steel-200 space-y-1">
            <div class="font-bold"><%= address.name %></div>
            <div><%= address.line1 %></div>
            <% if address.line2.present? %><div><%= address.line2 %></div><% end %>
            <div><%= address.city %>, <%= address.state %> <%= address.postal_code %></div>
            <div><%= address.country %></div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card-aero p-12 text-center">
      <p class="text-steel-400">No addresses saved yet.</p>
      <%= link_to "Add Address", new_account_address_path, class: "btn-primary mt-4" %>
    </div>
  <% end %>
</div>
