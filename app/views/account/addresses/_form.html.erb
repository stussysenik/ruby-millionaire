<div class="card-aero p-8">
  <%= form_with model: address, url: address.persisted? ? account_address_path(address) : account_addresses_path, class: "space-y-5" do |f| %>
    <% if address.errors.any? %>
      <div class="flash-alert text-sm">
        <% address.errors.full_messages.each do |msg| %>
          <div><%= msg %></div>
        <% end %>
      </div>
    <% end %>

    <div>
      <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Type</label>
      <%= f.select :address_type, [["Shipping", "shipping"], ["Billing", "billing"]], {}, class: "select-aero" %>
    </div>

    <div>
      <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Full Name</label>
      <%= f.text_field :name, class: "input-aero", required: true %>
    </div>

    <div>
      <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Address Line 1</label>
      <%= f.text_field :line1, class: "input-aero", required: true %>
    </div>

    <div>
      <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Address Line 2</label>
      <%= f.text_field :line2, class: "input-aero" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">City</label>
        <%= f.text_field :city, class: "input-aero", required: true %>
      </div>
      <div>
        <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">State</label>
        <%= f.text_field :state, class: "input-aero", required: true %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Postal Code</label>
        <%= f.text_field :postal_code, class: "input-aero", required: true %>
      </div>
      <div>
        <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Country</label>
        <%= f.text_field :country, class: "input-aero", required: true %>
      </div>
    </div>

    <div class="flex gap-4">
      <%= f.submit address.persisted? ? "Update Address" : "Save Address", class: "btn-primary" %>
      <%= link_to "Cancel", account_addresses_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
