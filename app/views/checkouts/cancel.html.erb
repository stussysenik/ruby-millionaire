<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
  <div class="card-aero p-12">
    <div class="w-20 h-20 mx-auto rounded-full bg-caution/10 border-2 border-caution flex items-center justify-center mb-6">
      <svg class="w-10 h-10 text-caution" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
    </div>

    <h1 class="font-display text-3xl font-bold tracking-wider text-steel-100 mb-4">Checkout Cancelled</h1>
    <p class="text-steel-300 mb-8">Your cart items are still saved. You can complete your purchase anytime.</p>

    <div class="flex justify-center gap-4">
      <%= link_to "Return to Cart", cart_path, class: "btn-primary" %>
      <%= link_to "Browse Catalog", products_path, class: "btn-secondary" %>
    </div>
  </div>
</div>
