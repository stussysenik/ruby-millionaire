<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
  <div class="card-aero p-12">
    <div class="w-20 h-20 mx-auto rounded-full bg-success/10 border-2 border-success flex items-center justify-center mb-6">
      <svg class="w-10 h-10 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>
    </div>

    <h1 class="font-display text-3xl font-bold tracking-wider text-steel-100 mb-4">Order Confirmed</h1>

    <% if @order %>
      <p class="text-steel-300 mb-2">Your order <span class="font-mono text-accent"><%= @order.order_number %></span> has been placed successfully.</p>
      <p class="text-sm text-steel-400 mb-8">You'll receive a confirmation email shortly.</p>
      <div class="flex justify-center gap-4">
        <%= link_to "View Order", account_order_path(@order), class: "btn-primary" %>
        <%= link_to "Continue Shopping", products_path, class: "btn-secondary" %>
      </div>
    <% else %>
      <p class="text-steel-300 mb-2">Your payment was received. Your order is being processed.</p>
      <p class="text-sm text-steel-400 mb-8">You'll receive a confirmation email shortly.</p>
      <%= link_to "Continue Shopping", products_path, class: "btn-primary" %>
    <% end %>
  </div>
</div>
