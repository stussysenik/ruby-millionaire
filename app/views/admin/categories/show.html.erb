<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="section-heading"><%= @category.name %></h1>
    <%= link_to "Edit", edit_admin_category_path(@category), class: "btn-primary btn-sm" %>
  </div>

  <div class="card-aero p-6">
    <p class="text-steel-300"><%= @category.description %></p>
    <div class="mt-4 text-sm text-steel-400">
      <span class="font-mono">Slug: <%= @category.slug %></span> &bull;
      <span><%= @products.count %> products</span>
    </div>
  </div>
</div>
