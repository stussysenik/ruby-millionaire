<div class="max-w-lg">
  <div class="card-aero p-8">
    <%= form_with model: [:admin, category], class: "space-y-5" do |f| %>
      <% if category.errors.any? %>
        <div class="flash-alert text-sm">
          <% category.errors.full_messages.each do |msg| %>
            <div><%= msg %></div>
          <% end %>
        </div>
      <% end %>

      <div>
        <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Name</label>
        <%= f.text_field :name, class: "input-aero", required: true %>
      </div>

      <div>
        <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Description</label>
        <%= f.text_area :description, class: "input-aero", rows: 3 %>
      </div>

      <div>
        <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Parent Category</label>
        <%= f.collection_select :parent_id, Category.roots.where.not(id: category.id).order(:name), :id, :name, { include_blank: "None (Root)" }, class: "select-aero" %>
      </div>

      <div>
        <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Position</label>
        <%= f.number_field :position, class: "input-aero", min: 0 %>
      </div>

      <label class="flex items-center gap-2 cursor-pointer">
        <%= f.check_box :active, class: "rounded bg-aero-900 border-aero-600 text-accent focus:ring-accent" %>
        <span class="text-sm text-steel-200">Active</span>
      </label>

      <div class="flex gap-4">
        <%= f.submit category.persisted? ? "Update Category" : "Create Category", class: "btn-primary" %>
        <%= link_to "Cancel", admin_categories_path, class: "btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
