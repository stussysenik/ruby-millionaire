<div class="space-y-6">
  <h1 class="section-heading">Edit User</h1>

  <div class="max-w-lg">
    <div class="card-aero p-8">
      <%= form_with model: [:admin, @user], class: "space-y-5" do |f| %>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">First Name</label>
            <%= f.text_field :first_name, class: "input-aero" %>
          </div>
          <div>
            <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Last Name</label>
            <%= f.text_field :last_name, class: "input-aero" %>
          </div>
        </div>

        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Phone</label>
          <%= f.telephone_field :phone, class: "input-aero" %>
        </div>

        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :admin, class: "rounded bg-aero-900 border-aero-600 text-accent focus:ring-accent" %>
          <span class="text-sm text-steel-200">Admin</span>
        </label>

        <div class="flex gap-4">
          <%= f.submit "Update User", class: "btn-primary" %>
          <%= link_to "Cancel", admin_user_path(@user), class: "btn-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
