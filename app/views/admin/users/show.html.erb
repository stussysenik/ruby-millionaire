<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <div class="flex items-center gap-2 text-sm text-steel-400 mb-2">
        <%= link_to "Users", admin_users_path, class: "hover:text-accent" %> /
        <span class="text-steel-200"><%= @user.full_name %></span>
      </div>
      <h1 class="section-heading text-xl"><%= @user.full_name %></h1>
    </div>
    <%= link_to "Edit", edit_admin_user_path(@user), class: "btn-secondary btn-sm" %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="card-aero p-6">
      <h3 class="font-display text-sm uppercase tracking-widest text-steel-400 mb-4">Details</h3>
      <div class="space-y-3 text-sm">
        <div><span class="text-steel-400">Email:</span> <span class="font-mono text-steel-100"><%= @user.email_address %></span></div>
        <div><span class="text-steel-400">Phone:</span> <span class="text-steel-100"><%= @user.phone || "—" %></span></div>
        <div><span class="text-steel-400">Role:</span>
          <% if @user.admin? %>
            <span class="badge bg-caution/10 text-caution border border-caution/30">Admin</span>
          <% else %>
            <span class="badge bg-aero-600/30 text-steel-300 border border-aero-600">Customer</span>
          <% end %>
        </div>
        <div><span class="text-steel-400">Member Since:</span> <span class="text-steel-100"><%= @user.created_at.strftime("%B %d, %Y") %></span></div>
      </div>
    </div>

    <div class="lg:col-span-2 card-aero overflow-hidden">
      <div class="px-6 py-4 border-b border-aero-700">
        <h3 class="font-display text-sm uppercase tracking-widest text-steel-300">Recent Orders</h3>
      </div>
      <% if @orders.any? %>
        <% @orders.each do |order| %>
          <%= link_to admin_order_path(order), class: "block px-6 py-3 border-b border-aero-700/50 hover:bg-aero-700/30 transition-colors" do %>
            <div class="flex items-center justify-between">
              <div>
                <span class="font-mono text-xs text-accent"><%= order.order_number %></span>
                <span class="text-xs text-steel-400 ml-2"><%= order.created_at.strftime("%b %d, %Y") %></span>
              </div>
              <div class="flex items-center gap-3">
                <span class="font-mono text-sm text-steel-100"><%= format_price(order.total_cents) %></span>
                <%= status_badge(order.status) %>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <div class="px-6 py-8 text-center text-sm text-steel-400">No orders yet.</div>
      <% end %>
    </div>
  </div>
</div>
