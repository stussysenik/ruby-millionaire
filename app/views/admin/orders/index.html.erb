<div class="space-y-6">
  <h1 class="section-heading">Orders</h1>

  <div class="card-aero overflow-hidden">
    <table class="table-aero">
      <thead>
        <tr>
          <th>Order</th>
          <th>Customer</th>
          <th>Items</th>
          <th>Total</th>
          <th>Status</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <tr class="cursor-pointer" onclick="window.location='<%= admin_order_path(order) %>'">
            <td class="font-mono text-accent text-sm"><%= order.order_number %></td>
            <td class="text-sm"><%= order.user.full_name %></td>
            <td class="text-sm"><%= order.order_items.size %></td>
            <td class="font-mono text-sm"><%= format_price(order.total_cents) %></td>
            <td><%= status_badge(order.status) %></td>
            <td class="text-xs text-steel-400"><%= order.created_at.strftime("%b %d, %Y") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4">
    <%== @pagy.series_nav %>
  </div>
</div>
