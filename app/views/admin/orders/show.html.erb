<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <div class="flex items-center gap-2 text-sm text-steel-400 mb-2">
        <%= link_to "Orders", admin_orders_path, class: "hover:text-accent" %> /
        <span class="text-steel-200"><%= @order.order_number %></span>
      </div>
      <h1 class="section-heading text-xl"><%= @order.order_number %></h1>
    </div>
    <%= status_badge(@order.status) %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <!-- Items -->
      <div class="card-aero overflow-hidden">
        <div class="px-6 py-4 border-b border-aero-700">
          <h3 class="font-display text-sm uppercase tracking-widest text-steel-300">Order Items</h3>
        </div>
        <table class="table-aero">
          <thead>
            <tr>
              <th>Product</th>
              <th>SKU</th>
              <th>Qty</th>
              <th>Unit Price</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <% @order.order_items.each do |item| %>
              <tr>
                <td class="font-bold text-steel-100 text-sm"><%= item.product_name %></td>
                <td class="font-mono text-xs"><%= item.product_sku %></td>
                <td><%= item.quantity %></td>
                <td class="font-mono text-sm"><%= format_price(item.unit_price_cents) %></td>
                <td class="font-mono text-sm"><%= format_price(item.line_total_cents) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <div class="px-6 py-4 border-t border-aero-700 space-y-1">
          <div class="flex justify-between text-sm text-steel-400"><span>Subtotal</span><span><%= format_price(@order.subtotal_cents) %></span></div>
          <div class="flex justify-between text-sm text-steel-400"><span>Shipping</span><span><%= format_price(@order.shipping_cents) %></span></div>
          <div class="flex justify-between text-sm text-steel-400"><span>Tax</span><span><%= format_price(@order.tax_cents) %></span></div>
          <div class="flex justify-between font-bold text-steel-100 pt-2 border-t border-aero-700"><span>Total</span><span class="text-accent"><%= format_price(@order.total_cents) %></span></div>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <!-- Update Status -->
      <div class="card-aero p-6">
        <h3 class="font-display text-sm uppercase tracking-widest text-steel-400 mb-4">Update Status</h3>
        <%= form_with model: [:admin, @order], class: "space-y-4" do |f| %>
          <%= f.select :status, Order.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "select-aero" %>
          <%= f.submit "Update", class: "btn-primary btn-sm w-full" %>
        <% end %>
      </div>

      <!-- Customer -->
      <div class="card-aero p-6">
        <h3 class="font-display text-sm uppercase tracking-widest text-steel-400 mb-4">Customer</h3>
        <div class="text-sm text-steel-200"><%= @order.user.full_name %></div>
        <div class="text-xs font-mono text-steel-400"><%= @order.user.email_address %></div>
      </div>

      <!-- Shipping -->
      <% if @order.shipping_line1.present? %>
        <div class="card-aero p-6">
          <h3 class="font-display text-sm uppercase tracking-widest text-steel-400 mb-4">Shipping Address</h3>
          <div class="text-sm text-steel-200 space-y-1">
            <div><%= @order.shipping_name %></div>
            <div><%= @order.shipping_line1 %></div>
            <% if @order.shipping_line2.present? %><div><%= @order.shipping_line2 %></div><% end %>
            <div><%= @order.shipping_city %>, <%= @order.shipping_state %> <%= @order.shipping_postal_code %></div>
          </div>
        </div>
      <% end %>

      <!-- Stripe -->
      <div class="card-aero p-6">
        <h3 class="font-display text-sm uppercase tracking-widest text-steel-400 mb-4">Payment</h3>
        <div class="text-xs font-mono text-steel-400 space-y-1">
          <div>Session: <%= @order.stripe_checkout_session_id || "—" %></div>
          <div>Intent: <%= @order.stripe_payment_intent_id || "—" %></div>
        </div>
      </div>
    </div>
  </div>
</div>
