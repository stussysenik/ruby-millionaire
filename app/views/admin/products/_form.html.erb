<div class="max-w-3xl">
  <div class="card-aero p-8">
    <%= form_with model: [:admin, product], class: "space-y-6" do |f| %>
      <% if product.errors.any? %>
        <div class="flash-alert text-sm">
          <% product.errors.full_messages.each do |msg| %>
            <div><%= msg %></div>
          <% end %>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Name</label>
          <%= f.text_field :name, class: "input-aero", required: true %>
        </div>
        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">SKU</label>
          <%= f.text_field :sku, class: "input-aero font-mono", required: true %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Part Number</label>
          <%= f.text_field :part_number, class: "input-aero font-mono" %>
        </div>
        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Category</label>
          <%= f.collection_select :category_id, Category.all.order(:name), :id, :name, { prompt: "Select..." }, class: "select-aero" %>
        </div>
      </div>

      <div>
        <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Description</label>
        <%= f.text_area :description, class: "input-aero", rows: 4 %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Price (cents)</label>
          <%= f.number_field :price_cents, class: "input-aero font-mono", required: true, min: 1 %>
        </div>
        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Compare at Price (cents)</label>
          <%= f.number_field :compare_at_price_cents, class: "input-aero font-mono" %>
        </div>
        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Stock Quantity</label>
          <%= f.number_field :stock_quantity, class: "input-aero font-mono", min: 0 %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Material</label>
          <%= f.text_field :material, class: "input-aero" %>
        </div>
        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">MIL-SPEC</label>
          <%= f.text_field :mil_spec, class: "input-aero font-mono" %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Certification</label>
          <%= f.text_field :certification, class: "input-aero" %>
        </div>
        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Weight (kg)</label>
          <%= f.number_field :weight_kg, class: "input-aero font-mono", step: 0.001 %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Temp Min (&deg;F)</label>
          <%= f.number_field :temperature_min, class: "input-aero font-mono" %>
        </div>
        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Temp Max (&deg;F)</label>
          <%= f.number_field :temperature_max, class: "input-aero font-mono" %>
        </div>
      </div>

      <div>
        <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Images</label>
        <%= f.file_field :images, multiple: true, class: "input-aero file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-bold file:bg-accent/10 file:text-accent hover:file:bg-accent/20", accept: "image/*" %>
      </div>

      <div class="flex items-center gap-6">
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :active, class: "rounded bg-aero-900 border-aero-600 text-accent focus:ring-accent" %>
          <span class="text-sm text-steel-200">Active</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :featured, class: "rounded bg-aero-900 border-aero-600 text-accent focus:ring-accent" %>
          <span class="text-sm text-steel-200">Featured</span>
        </label>
      </div>

      <div class="flex gap-4">
        <%= f.submit product.persisted? ? "Update Product" : "Create Product", class: "btn-primary" %>
        <%= link_to "Cancel", admin_products_path, class: "btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
