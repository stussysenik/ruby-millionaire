<div class="min-h-[80vh] flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="font-display text-2xl font-bold tracking-wider text-steel-100">New Password</h1>
      <p class="text-sm text-steel-400 mt-1">Enter your new password below</p>
    </div>

    <div class="card-aero p-8">
      <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |f| %>
        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">New Password</label>
          <%= f.password_field :password, class: "input-aero", placeholder: "Minimum 8 characters", autofocus: true, required: true %>
        </div>

        <div>
          <label class="block text-xs font-display uppercase tracking-widest text-steel-400 mb-2">Confirm Password</label>
          <%= f.password_field :password_confirmation, class: "input-aero", placeholder: "Repeat password", required: true %>
        </div>

        <%= f.submit "Update Password", class: "btn-primary w-full" %>
      <% end %>
    </div>
  </div>
</div>
